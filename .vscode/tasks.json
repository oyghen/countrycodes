{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Install workspace dependencies",
            "type": "shell",
            "command": "uv sync --dev --all-packages",
            "inAgents": true,
            "runOptions": {
                "runOn": "worktreeCreated"
            },
            "problemMatcher": []
        },
        {
            "label": "pre-commit all",
            "type": "shell",
            "command": "uv run pre-commit run --all-files",
            "inAgents": true,
            "problemMatcher": []
        },
        {
            "label": "pytest",
            "type": "shell",
            "command": "uv",
            "args": [
                "run",
                "--no-sync",
                "pytest",
                "--verbose",
                "--doctest-modules",
                "--ignore=user",
                "--ignore=version.py"
            ],
            "inAgents": true,
            "problemMatcher": []
        },
        {
            "label": "CountryCodes: Checks",
            "dependsOn": [
                "pre-commit all",
                "pytest"
            ],
            "dependsOrder": "sequence",
            "inAgents": true,
            "problemMatcher": []
        }
    ]
}
